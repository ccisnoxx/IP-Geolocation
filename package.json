{
  "name": "vanishgeo",
  "version": "2.1.0",
  "description": "VanishGeo - Browser privacy leak protection and environment consistency management tool",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --project tsconfig.test.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run typecheck:tests && npm test && npm run build",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "serve:leak-test": "node scripts/serve-leak-test.mjs",
    "test:e2e:chrome": "node scripts/chrome-acceptance.mjs"
  },
  "keywords": [
    "privacy",
    "browser-extension",
    "geolocation",
    "webrtc",
    "timezone",
    "language"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.12.7",
    "typescript": "^5.4.5",
    "vite": "^5.2.10",
    "tsx": "^4.20.3",
    "vite-plugin-static-copy": "^1.0.4"
  }
}
