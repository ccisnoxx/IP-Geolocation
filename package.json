{
  "name": "vanishgeo",
  "version": "2.3.0",
  "description": "VanishGeo - Browser privacy leak protection and environment consistency management tool",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "tsx --test tests/*.test.ts",
    "setup:chrome119": "node scripts/setup-browsers.mjs --chrome=119",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "env": "node tools/chrome-env.mjs",
    "probe": "node tools/verify-env.mjs --frameHost=localhost",
    "build:persona": "node scripts/build-persona.mjs",
    "release": "node scripts/release.mjs",
    "verify:release": "node tools/verify-release.mjs",
    "smoke:options": "node tools/smoke-options.mjs",
    "audit:native": "node tools/native-audit.mjs",
    "smoke:failclosed": "node tools/smoke-failclosed.mjs",
    "smoke:frames": "node tools/smoke-frames.mjs",
    "smoke:workers": "node tools/smoke-workers.mjs",
    "smoke:bfcache": "node tools/smoke-bfcache.mjs",
    "smoke:baked-failclosed": "node tools/smoke-baked-failclosed.mjs",
    "smoke:baked-clear": "node tools/smoke-baked-clear.mjs",
    "smoke:presets": "node tools/smoke-presets.mjs",
    "smoke:release": "node tools/smoke-release.mjs",
    "smoke:cold-start": "node tools/smoke-cold-start.mjs",
    "smoke:cold-save": "node tools/smoke-cold-save.mjs",
    "smoke:popup": "node tools/smoke-popup.mjs",
    "smoke:real-site": "node tools/smoke-real-site.mjs",
    "audit": "node tools/audit.mjs",
    "smoke:ipchange": "node tools/smoke-ip-change.mjs",
    "smoke:ipfollow": "node tools/smoke-ip-follow.mjs",
    "smoke:ipapply": "node tools/smoke-ip-apply.mjs",
    "probe:cost": "node tools/probe-cost.mjs",
    "smoke:fingerprint": "node tools/smoke-fingerprint.mjs",
    "audit:parity": "node tools/native-parity.mjs",
    "verify": "npm run lint && npm run typecheck && npm test",
    "test:coverage": "tsx --test --experimental-test-coverage tests/*.test.ts",
    "test:coverage:core": "c8 --include='src/background/services.ts' --include='src/background/dnr.ts' --include='src/content/content-bridge.ts' --include='src/injected/baked-resolver.ts' --include='src/shared/config-model.ts' --include='src/shared/config-resolver.ts' --include='src/shared/profile.ts' --include='src/shared/site-status.ts' --reporter=text --check-coverage --per-file --branches=85 --lines=0 --functions=0 --statements=0 node_modules/.bin/tsx --test tests/*.test.ts"
  },
  "keywords": [
    "privacy",
    "browser-extension",
    "geolocation",
    "webrtc",
    "timezone",
    "language"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.12.7",
    "c8": "^12.0.0",
    "eslint": "^9.39.4",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.2.10",
    "vite-plugin-static-copy": "^1.0.4"
  }
}
