{
  "manifest_version": 3,
  "name": "VanishGeo",
  "version": "2.1.1",
  "minimum_chrome_version": "138",
  "description": "Allowlisted language/timezone and Accept-Language, geolocation permission management, and layered font filtering.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "contextMenus",
    "privacy",
    "userScripts",
    "declarativeNetRequestWithHostAccess",
    "contentSettings",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [{ "id": "header_migration_guard", "enabled": true, "path": "rules/header-migration-guard.json" }]
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "web_accessible_resources": []
}
